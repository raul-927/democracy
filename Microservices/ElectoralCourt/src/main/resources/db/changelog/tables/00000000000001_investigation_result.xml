<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

        <property name="autoIncrement" value="true"/>
        
    <changeSet id="00000000000002" author="rhernandez">

        <createTable tableName="INVESTIGATION_RESULT">
            <column name="investigation_result_id"                type="varchar(36)" defaultValueComputed="${u_id}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="investigation_id"     type="varchar(100)"/>
            <column name ="cedula"              type="int"/>
            <column name="person_id"            type="varchar(100)"/>
            <column name="observation" 	        type="varchar(100)"/>
            <column name="score" 	            type="int"/>
            <column name="is_approve" 	        type="boolean"/>
        </createTable>

    </changeSet>
</databaseChangeLog>
