<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

        <property name="autoIncrement" value="true"/>
        
    <changeSet id="00000000000003" author="rhernandez">

        <createTable tableName="POSTULANT">
            <column name="postulant_id"                type="varchar(36)" defaultValueComputed="${u_id}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="investigation_result_id"     type="varchar(100)"/>
            <column name ="cedula"           type="int"/>
            <column name="first_name"        type="varchar(100)"/>
            <column name="second_name" 	     type="varchar(100)"/>
            <column name="first_last_name" 	 type="varchar(100)"/>
            <column name="second_last_name"  type="varchar(100)"/>
        </createTable>

    </changeSet>
</databaseChangeLog>
